# +-------------------+
# | Utils Functions |
# +-------------------+

function require_commands () {
  local command_name

  for command_name in "$@"; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
      echo "Error: required command not found: ${command_name}" >&2
      return 1
    fi
  done
}

function has_command () {
  command -v "$1" >/dev/null 2>&1
}

function update_packages () {
  local os_name

  os_name=$(uname -s)

  case "${os_name}" in
    Linux|Darwin)
      if has_command brew; then
        echo "✨ updating Homebrew packages"
        if ! brew update; then
          echo "Error: failed to update Homebrew packages" >&2
          return 1
        fi

        if ! brew upgrade; then
          echo "Error: failed to upgrade Homebrew packages" >&2
          return 1
        fi
      elif has_command apt-get; then
        echo "✨ updating apt packages"
        if ! sudo apt-get update; then
          echo "Error: failed to update apt package lists" >&2
          return 1
        fi

        if ! sudo apt-get upgrade -y; then
          echo "Error: failed to upgrade apt packages" >&2
          return 1
        fi
      else
        echo "Error: no supported package manager found (brew or apt-get)." >&2
        return 1
      fi
      ;;
    *)
      echo "Error: unsupported operating system: ${os_name}" >&2
      return 1
      ;;
  esac
}

jwt() { jq -R 'split(".") | .[1] | @base64d | fromjson' <<< $1; }

function npmrc() {
  local profile_dir="$HOME/.config/npm/profiles"
  local profile="$1"

  if [[ ! -d "$profile_dir" ]]; then
    echo "Error: profiles directory not found: ${profile_dir}" >&2
    return 1
  fi

  local -a available_profiles
  available_profiles=($(ls "$profile_dir" 2>/dev/null))

  if [[ ${#available_profiles[@]} -eq 0 ]]; then
    echo "Error: no profiles found in ${profile_dir}" >&2
    return 1
  fi

  local _npmrc_list_profiles() {
    local p
    for p in "${available_profiles[@]}"; do
      echo "  - ${p}"
    done
  }

  case "$profile" in
    ""|"-h"|"--help")
      echo "Usage: npmrc <profile|status>"
      echo "Available profiles:"
      _npmrc_list_profiles
      return 0
      ;;
    status)
      echo "registry:      $(npm config get registry)"
      echo "@sap:registry: $(npm config get @sap:registry 2>/dev/null || echo 'not set')"
      return 0
      ;;
    *)
      if [[ ! -f "$profile_dir/$profile" ]]; then
        echo "Error: unknown profile '${profile}'" >&2
        echo "Available profiles:" >&2
        _npmrc_list_profiles >&2
        return 1
      fi

      cp "$profile_dir/$profile" "$HOME/.npmrc"
      echo "Switched to npm profile: ${profile}"
      ;;
  esac
}

function npm_update_global() {
  if ! require_commands npm jq; then
    return 1
  fi

  local -a packages
  packages=($(npm list -g --depth=0 --json 2>/dev/null | jq -r '.dependencies | keys[]'))

  if [[ ${#packages[@]} -eq 0 ]]; then
    echo "No global packages found."
    return 0
  fi

  local pkg failed=0 skipped=0 updated=0

  for pkg in "${packages[@]}"; do
    echo "Updating ${pkg}..."
    if npm update -g "$pkg" 2>/dev/null; then
      (( updated++ ))
    else
      echo "  ⚠ Skipped: ${pkg} (not found or access denied)"
      (( skipped++ ))
    fi
  done

  echo ""
  echo "Done. Updated: ${updated}, Skipped: ${skipped}"
}

# +-------------------+
# | Kubectl Functions |
# +-------------------+

function kdecode () {
  local secret=""
  local namespace="default"
  local secret_json

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo "Usage: kdecode <secret_name> -n <namespace>"
        return 0
        ;;
      -n|--namespace)
        if [[ -z "$2" || "$2" == -* ]]; then
          echo "Usage: kdecode <secret_name> -n <namespace>" >&2
          return 1
        fi

        namespace="$2"
        shift 2
        ;;
      *)
        if [[ -n "${secret}" ]]; then
          echo "Usage: kdecode <secret_name> -n <namespace>" >&2
          return 1
        fi

        secret="$1"
        shift
        ;;
      -*)
        echo "Usage: kdecode <secret_name> -n <namespace>" >&2
        return 1
        ;;
    esac
  done

  if [[ -z "${secret}" || -z "${namespace}" ]]; then
    echo "Usage: kdecode <secret_name> -n <namespace>" >&2
    return 1
  fi

  if ! require_commands kubectl jq base64; then
    return 1
  fi

  if ! secret_json=$(kubectl get secret "${secret}" -n "${namespace}" -o json); then
    return 1
  fi

  jq -r '.data // {} | to_entries[] | [.key, .value] | @tsv' <<< "${secret_json}" |
    while IFS=$'\t' read -r key encoded_value; do
      printf '%s: %s\n' "${key}" "$(printf '%s' "${encoded_value}" | base64 --decode)"
    done
}
